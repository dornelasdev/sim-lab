Screen {
    layout: vertical;
    background: $background;
    color: $text;
}

Header {
    height: 2;
    background: $background;
    color: $text;
    border-bottom: ascii $border-blurred;
}

HeaderTitle {
    color: $title-color;
    text-style: bold;
}

Footer {
    background: $background;
}

.panel {
    background: $background;
    border: ascii $border-blurred;
    border-title-color: $title-color;
    border-title-style: bold;
    border-subtitle-color: $foreground;
    border-subtitle-style: dim;
}

Button {
    height: 1;
    min-width: 0;
    padding: 0 1;
    content-align: left middle;
    text-align: left;
    color: $action-color;
    background: $background;
    border: none;
    border-left: blank $background;
    text-style: bold;
}

Button.-primary {
    color: $primary;
}

Button.-warning {
    color: $warning;
}

Button:hover {
    color: $action-focus-color;
    text-style: underline;
}

Button:focus {
    color: $action-focus-color;
    border-left: ascii $accent;
    text-style: bold;
}

Button.-warning:hover, Button.-warning:focus {
    color: $warning;
}

Button.-warning:focus {
    border-left: ascii $warning;
}

Button.-active {
    background: $background !important;
    border: none !important;
    border-left: ascii $accent !important;
    tint: transparent;
}

Button:disabled {
    color: $text-disabled;
    border: none !important;
    border-left: blank $background !important;
    background: $background !important;
    text-style: dim strike;
}

Input {
    height: 1;
    padding: 0 1;
    color: $text;
    background: $background;
    border: none;
    border-left: blank $background;
}

Input:hover {
    text-style: underline;
}

Input:focus {
    background-tint: transparent;
    border-left: ascii $accent;
    text-style: none;
}

Input.-invalid, Input.-invalid:focus {
    border-left: ascii $error;
}

Input > .input--selection {
    background: $background;
    color: $text;
    text-style: reverse;
}

Checkbox {
    height: 1;
    padding: 0 1;
    content-align: left middle;
    color: $action-color;
    background: $background;
    border: none;
    border-left: blank $background;
    text-style: bold;
}

Checkbox:hover > .toggle--label {
    text-style: underline;
}

Checkbox:focus {
    color: $action-focus-color;
    background-tint: transparent;
    border-left: ascii $accent;
}

Checkbox:focus > .toggle--label {
    color: $action-focus-color;
    background: $background;
    text-style: bold;
}

Checkbox > .toggle--button {
    background: $background;
    color: $text;
}

Checkbox.-on > .toggle--button {
    background: $background;
    color: $accent;
}

#welcome-page {
    height: 1fr;
    padding: 3 4;
    align: center middle;
}

#welcome-card {
    width: 76;
    max-width: 100%;
    height: auto;
    padding: 1 2;
}

#welcome-card Button {
    width: 1fr;
    margin-top: 1;
}

Select {
    height: 1;
}

Select > SelectCurrent {
    height: 1;
    padding: 0 1;
    color: $text;
    background: $background;
    border: none;
    border-left: blank $background;
}

Select > SelectCurrent #label {
    color: $action-color;
    text-style: bold;
}

Select:hover > SelectCurrent #label {
    color: $action-focus-color;
    text-style: underline;
}

Select:focus > SelectCurrent {
    background-tint: transparent;
    border-left: ascii $accent;
}

Select:focus > SelectCurrent #label {
    color: $action-focus-color;
    text-style: bold;
}

Select:disabled > SelectCurrent #label {
    color: $text-disabled;
    text-style: dim strike;
}

Select > SelectOverlay {
    color: $text;
    background: $background;
    border: ascii $border-blurred;
}

Select > SelectOverlay:focus {
    border: ascii $accent;
    background-tint: transparent;
}

SelectOverlay > .option-list--option-hover {
    background: $dropdown-hover-background;
    color: $dropdown-highlight-foreground;
    text-style: underline;
}

SelectOverlay > .option-list--option-highlighted,
SelectOverlay:focus > .option-list--option-highlighted {
    background: $dropdown-active-background;
    color: $dropdown-highlight-foreground;
    text-style: bold;
}

GuideScreen {
    align: center middle;
    background: $background;
}

#guide-dialog {
    width: 96;
    max-width: 90%;
    height: 38;
    max-height: 90%;
    padding: 1 2;
}

#guide-content-scroll {
    height: 1fr;
    padding: 0 1;
}

#guide-content {
    height: auto;
}

#guide-actions {
    height: 1;
    margin-top: 1;
    align: right middle;
}
