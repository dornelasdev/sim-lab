<!--
  Compatibility target: Wazuh 4.14.7.

  Stock lineage:
    4625 -> 60104 -> 60105 -> 60122 -> 100100
    4776 -> 60104 -> 100110

  Level-1 rules qualify events but remain hidden. Level-10 rules are the
  analyst-facing password-spray signals.
-->
<group name="simlab,windows,authentication_failures,">
  <rule id="100100" level="1">
    <if_sid>60122</if_sid>
    <field name="win.system.eventID">^4625$</field>
    <field name="win.eventdata.status" type="pcre2">(?i)^0xc000006d$</field>
    <field name="win.eventdata.subStatus" type="pcre2">(?i)^0xc000006a$</field>
    <field name="win.eventdata.logonType">^3$</field>
    <field name="win.eventdata.authenticationPackageName" type="pcre2">(?i)^NTLM$</field>
    <description>SimLab: qualifying NTLM network logon failure</description>
    <options>no_log</options>
  </rule>

  <rule id="100101" level="10" frequency="3" timeframe="60">
    <if_matched_sid>100100</if_matched_sid>
    <same_field>win.eventdata.ipAddress</same_field>
    <same_field>win.system.computer</same_field>
    <different_field>win.eventdata.targetUserName</different_field>
    <description>SimLab: suspected password spray from $(win.eventdata.ipAddress) against $(win.system.computer)</description>
    <group>password_spray,authentication_attack,</group>
    <mitre>
      <id>T1110.003</id>
    </mitre>
  </rule>

  <rule id="100110" level="1">
    <if_sid>60104</if_sid>
    <field name="win.system.eventID">^4776$</field>
    <field name="win.eventdata.status" type="pcre2">(?i)^0xc000006a$</field>
    <description>SimLab: qualifying NTLM credential-validation failure</description>
    <options>no_log</options>
  </rule>

  <rule id="100111" level="10" frequency="3" timeframe="60">
    <if_matched_sid>100110</if_matched_sid>
    <same_field>win.eventdata.workstation</same_field>
    <same_field>win.system.computer</same_field>
    <different_field>win.eventdata.targetUserName</different_field>
    <description>SimLab: suspected password spray from $(win.eventdata.workstation) observed by $(win.system.computer)</description>
    <group>password_spray,authentication_attack,</group>
    <mitre>
      <id>T1110.003</id>
    </mitre>
  </rule>
</group>
